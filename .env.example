# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# --- OpenAI (chat + embeddings + RAG) ---
OPENAI_API_KEY=
# Chat model for /api/chat (OpenAI Chat Completions)
MODEL_NAME=gpt-4.1-mini

# --- ChatKit ---
# OpenAI-hosted workflow when custom URL below is unset:
WORKFLOW_ID=

# Custom backend: set to /api/chat for RAG (resume + knowledge/). Restart dev after changing.
NEXT_PUBLIC_CHATKIT_CUSTOM_API_URL=

# ChatKit domain key from OpenAI (required when using custom api.url, e.g. /api/chat)
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=

# Cal.com scheduling (optional)
# CAL_API_KEY=
# CAL_API_URL=https://api.cal.com/v1
# CAL_EVENT_TYPE_ID=
