# Copy to .env.local and fill in. Restart `npm run dev` after changes.

# --- ChatKit: OpenAI-hosted workflow (default when custom URL below is unset) ---
OPENAI_API_KEY=
WORKFLOW_ID=

# --- ChatKit: custom LLM backend (e.g. DeepSeek via /api/chat) ---
# Set to /api/chat to use app/api/chat/route.ts instead of OpenAI workflow sessions.
# NEXT_PUBLIC_CHATKIT_CUSTOM_API_URL=/api/chat
# DEEPSEEK_API_KEY=
# MODEL_NAME=deepseek-chat

# ChatKit domain key from OpenAI (required for custom api.url, e.g. /api/chat)
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=

# Cal.com scheduling (optional)
# CAL_API_KEY=
# CAL_API_URL=https://api.cal.com/v1
# CAL_EVENT_TYPE_ID=

# Optional overrides (other OpenAI-compatible providers)
# LLM_API_KEY=
# LLM_CHAT_COMPLETIONS_URL=https://api.deepseek.com/v1/chat/completions
# LLM_BASE_URL=
